{
  "name": "@arx/extension",
  "description": "manifest.json description",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "dev:chrome": "wxt -b chrome",
    "dev:firefox": "wxt -b firefox",
    "build": "pnpm build:chrome && pnpm build:firefox",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "zip": "pnpm zip:chrome && pnpm zip:firefox",
    "zip:chrome": "wxt zip -b chrome",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@arx/core": "workspace:*",
    "@arx/message-channel": "workspace:*",
    "@arx/provider": "workspace:*",
    "@arx/storage-dexie": "workspace:*",
    "@arx/wallet-api": "workspace:*",
    "webextension-polyfill": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/jsdom": "27.0.0",
    "@types/webextension-polyfill": "catalog:",
    "jsdom": "27.2.0",
    "typescript": "catalog:",
    "wxt": "0.20.27"
  }
}
